# Gaming Studio J multiplayer / admin settings.
# Copy this file to .env before docker compose up.

# Required for /admin.html. Use a long unique password (12+ characters).
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Required for signed admin session cookies. Use 32+ random characters.
# Example generator:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# The service remains on container port 80 so your existing
# v79_nginx_proxy route to gaming-studio-j:80 does not change.
\n# Optional: generate child-friendly definitions, sentences, hints and syllables with local Ollama.\n# Point this at an Ollama endpoint reachable from the gaming-studio-j container.\nOLLAMA_URL=\nOLLAMA_MODEL=qwen2.5:3b\n