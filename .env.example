# Gaming Studio J multiplayer / admin settings.
# Copy this file to .env before docker compose up.

# Required for /admin and /spelling-admin. Use a long unique password (12+ characters).
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Required for signed admin session cookies. Use 32+ random characters.
# Example generator:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional but strongly recommended for Spelling Bee learning content.
# Point this at an Ollama endpoint reachable from the gaming-studio-j container.
# If your Ollama container shares proxy_network and is named "ollama", use:
# OLLAMA_URL=http://ollama:11434
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:3b

# The service remains on container port 80 so the existing
# v79_nginx_proxy route to gaming-studio-j:80 does not change.
